{
  "name": "run-worker",
  "productName": "Run worker",
  "version": "0.0.2",
  "description": "Run worker — 桌面端全能 Agent，多智能体调度的万能系统助手",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "Run worker Team",
    "email": "team@runworker.dev"
  },
  "license": "MIT",
  "homepage": "https://github.com/LHRonline/run-worker",
  "repository": {
    "type": "git",
    "url": "https://github.com/LHRonline/run-worker.git"
  },
  "bugs": {
    "url": "https://github.com/LHRonline/run-worker/issues"
  },
  "keywords": [
    "electron",
    "ai-agent",
    "multi-agent",
    "desktop-agent",
    "deepseek",
    "mcp"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "preview": "node scripts/preview.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "release": "npm run dist",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npx tsc -p tsconfig.main.json && vite build && node scripts/run-e2e.mjs",
    "test:e2e:only": "node scripts/run-e2e.mjs",
    "test:packaged": "node tests/e2e/packaged.mjs",
    "icon": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
